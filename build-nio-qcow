#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Build an MS-DOS qcow2 image containing the NIO FUJINET.SYS driver.

Driver-only output defaults to build/msdos-nio.qcow2.
When --apps-manifest is used, output defaults to build/msdos-nio-apps.qcow2.

Options:
  -b, --base <image>           Base MS-DOS qcow/qcow2 image (env: BASE_IMAGE)
  -o, --output <image>         Output qcow2 image (env: OUTPUT_IMAGE)
  -m, --msdos-dir <path>       fujinet-msdos repository (env: FUJINET_MSDOS)
  -d, --driver <path>          FUJINET.SYS to inject (env: DRIVER)
      --apps-manifest <file>   YAML app manifest (env: APPS_MANIFEST)
  -h, --help                   Show this help message

Repository paths (relative to this repo unless absolute):
  FUJINET_MSDOS (required)

App paths are listed in manifests/apps.example.yaml. Copy it to
manifests/apps.yaml and set environment variables such as NIO_APPS_MSDOS and
BOUNCE_WORLD before building with --apps-manifest.

Examples:
  FUJINET_MSDOS=/path/to/fujinet-msdos $(basename "$0")
  FUJINET_MSDOS=/path/to/fujinet-msdos \\
    NIO_APPS_MSDOS=/path/to/nio-apps/msdos \\
    BOUNCE_WORLD=/path/to/bounce-world-client-nio \\
    $(basename "$0") --apps-manifest manifests/apps.yaml
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
fi

if ! command -v uv >/dev/null 2>&1; then
    echo "Missing required tool: uv" >&2
    echo "Install uv (see fujinet-nio README prerequisites)." >&2
    exit 1
fi

exec uv run --directory "$SCRIPT_DIR" fujinet-qemu-msdos "$@"
