#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

usage() {
    cat <<EOF
Usage: $(basename "$0") --apps-manifest <file> --output <image> [OPTIONS]

Build a raw MS-DOS FAT image from an apps YAML manifest.

Options:
      --apps-manifest <file>   YAML app manifest
  -o, --output <image>         Output raw FAT .img
      --repo-root <path>       Root for resolving relative manifest paths
  -l, --label <label>          MS-DOS volume label (default: NIOAPPS)
  -p, --preset <1440|2880>     Floppy-style KiB image size (default: 1440)
  -s, --size-mb <mb>           Image size in MiB; uses FAT16 by default
  -h, --help                   Show this help message
EOF
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
fi

if ! command -v uv >/dev/null 2>&1; then
    echo "Missing required tool: uv" >&2
    echo "Install uv (see fujinet-nio README prerequisites)." >&2
    exit 1
fi

export UV_CACHE_DIR="${UV_CACHE_DIR:-$SCRIPT_DIR/build/uv-cache}"
mkdir -p "$UV_CACHE_DIR"

exec uv run --directory "$SCRIPT_DIR" python -m fujinet_qemu_msdos.apps_image "$@"
